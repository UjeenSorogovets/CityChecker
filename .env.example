GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ALLOWED_USER_ID=your-google-sub
CONTACT_EMAIL=you@example.com

# Comma-separated emails allowed to use Offers / Otodom (empty = nobody)
OFFERS_ALLOWED_EMAILS=you@example.com
# Comma-separated emails that may edit/delete any note (empty = own notes only)
NOTES_ADMIN_EMAILS=you@example.com
# Show "Update offers" + allow scrape refresh (default false)
OFFERS_IS_UPDATE_OFFERS=false

# JWT signing for email/password accounts (required in production)
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Optional: note photos (Cloudinary free unsigned preset). Empty = hide photo UI.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Production (docker-compose.prod.yml + Caddy; TLS certs on host via Certbot)
DOMAIN=ujeen.pl
APP_PUBLIC_BASE_URL=https://ujeen.pl

# Local-only SSH for agent/scripts (NEVER commit .env). Used by: python scripts/remote.py
SSH_HOST=ujeen.pl
SSH_USER=root
SSH_PORT=22
SSH_PASSWORD=
